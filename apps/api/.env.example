# 闲遇 API 本地环境变量样例
# 复制为 `.env` 或导出到 shell 后再启动 `./scripts/dev-api.sh`。

# 开发者工具模拟器使用 local；需要真实微信 code2session 的真机调试使用 trial。
SPRING_PROFILES_ACTIVE=local

# API 服务端口。默认 8080，前端默认请求 http://127.0.0.1:8080。
SEREN_MEET_SERVER_PORT=8080

# PostgreSQL JDBC 地址。必须使用 PostgreSQL，不使用 H2、SQLite 或其他替代数据库。
SEREN_MEET_DB_URL=jdbc:postgresql://127.0.0.1:5432/seren_meet

# PostgreSQL 用户名。需与 infra/compose/docker-compose.yml 中 POSTGRES_USER 保持一致。
SEREN_MEET_DB_USER=seren_meet

# PostgreSQL 密码。需与 infra/compose/docker-compose.yml 中 POSTGRES_PASSWORD 保持一致。
SEREN_MEET_DB_PASSWORD=seren_meet

# 是否启用 Flyway 数据库迁移。本地开发和验收应保持 true。
SEREN_MEET_FLYWAY_ENABLED=true

# 后台 Web 允许跨域访问的主要来源。Vite 本地地址默认为 http://127.0.0.1:5173。
SEREN_MEET_ADMIN_ORIGIN=http://127.0.0.1:5173

# 后台 Web 允许跨域访问的备用来源。5173 被占用时 Vite 常自动切到 http://127.0.0.1:5174。
SEREN_MEET_ADMIN_FALLBACK_ORIGIN=http://127.0.0.1:5174

# 首个平台管理员只在管理员表为空且以下三项同时填写时创建一次，密码至少 12 个字符
SEREN_MEET_BOOTSTRAP_ADMIN_USERNAME=
SEREN_MEET_BOOTSTRAP_ADMIN_PASSWORD=
SEREN_MEET_BOOTSTRAP_ADMIN_DISPLAY_NAME=

# 员工登录密码可恢复密文的 AES-256-GCM keyring，以下两项必填。
# 使用 `openssl rand -base64 32` 生成密钥，keyring 格式为 `keyId=Base64,keyId2=Base64`。
# 轮换时新增 keyId 并切换 active key；旧 keyId 须保留至相关员工密码全部重置。
SEREN_MEET_STAFF_CREDENTIAL_ACTIVE_KEY_ID=
SEREN_MEET_STAFF_CREDENTIAL_KEYS=
SEREN_MEET_STAFF_CREDENTIAL_MAX_REVEALS=10
SEREN_MEET_STAFF_CREDENTIAL_REVEAL_WINDOW_MINUTES=1

# API 日志输出目录。默认写入 apps/api/logs/。
SEREN_MEET_LOG_PATH=logs

# 业务包日志级别。排查问题时可改为 DEBUG，验收和生产建议 INFO。
SEREN_MEET_LOG_LEVEL=INFO

# 店长端真机调试使用真实微信登录时必填，必须与小程序 project.config.json 一致。
SEREN_MEET_OWNER_WECHAT_APP_ID=
SEREN_MEET_OWNER_WECHAT_APP_SECRET=
