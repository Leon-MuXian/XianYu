<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <property name="LOG_PATH" value="${SEREN_MEET_LOG_PATH:-logs}" />
  <property name="APP_NAME" value="seren-meet-api" />

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"seren-meet-api"}</customFields>
      <includeMdcKeyName>requestId</includeMdcKeyName>
    </encoder>
  </appender>

  <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_PATH}/${APP_NAME}.log</file>
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_PATH}/${APP_NAME}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>2GB</totalSizeCap>
    </rollingPolicy>
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <customFields>{"service":"seren-meet-api"}</customFields>
      <includeMdcKeyName>requestId</includeMdcKeyName>
    </encoder>
  </appender>

  <logger name="com.serenmeet" level="${SEREN_MEET_LOG_LEVEL:-INFO}" />
  <logger name="org.springframework.web" level="INFO" />
  <logger name="com.baomidou.mybatisplus" level="INFO" />

  <root level="INFO">
    <appender-ref ref="CONSOLE" />
    <appender-ref ref="FILE" />
  </root>
</configuration>
