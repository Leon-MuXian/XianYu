# Copy to infra/compose/.env and replace all deployment-specific values.
SPRING_PROFILES_ACTIVE=local
SEREN_MEET_HTTP_PORT=8088
SEREN_MEET_DB_NAME=seren_meet
SEREN_MEET_DB_USER=seren_meet
SEREN_MEET_DB_PASSWORD=
SEREN_MEET_ADMIN_ORIGIN=http://127.0.0.1:8088

# The first administrator is created only when all three values are present and
# the administrator table is empty. The password must contain at least 12 characters.
SEREN_MEET_BOOTSTRAP_ADMIN_USERNAME=
SEREN_MEET_BOOTSTRAP_ADMIN_PASSWORD=
SEREN_MEET_BOOTSTRAP_ADMIN_DISPLAY_NAME=

# Required when SPRING_PROFILES_ACTIVE is trial or prod.
SEREN_MEET_OWNER_WECHAT_APP_ID=
SEREN_MEET_OWNER_WECHAT_APP_SECRET=
SEREN_MEET_MEMBER_WECHAT_APP_ID=
SEREN_MEET_MEMBER_WECHAT_APP_SECRET=
